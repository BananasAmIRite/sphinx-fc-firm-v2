 490:Core/Src/bmp5/bmp5.c **** int8_t bmp5_get_power_mode(enum bmp5_powermode *powermode, bmp5_dev *dev)
 491:Core/Src/bmp5/bmp5.c **** {
 492:Core/Src/bmp5/bmp5.c ****     int8_t rslt;
 493:Core/Src/bmp5/bmp5.c ****     uint8_t deep_dis;
 494:Core/Src/bmp5/bmp5.c ****     uint8_t reg_data;
 495:Core/Src/bmp5/bmp5.c ****     uint8_t pwrmode;
 496:Core/Src/bmp5/bmp5.c **** 
 497:Core/Src/bmp5/bmp5.c ****     if (powermode != NULL)
 498:Core/Src/bmp5/bmp5.c ****     {
 499:Core/Src/bmp5/bmp5.c ****         /* Read the power mode register */
 500:Core/Src/bmp5/bmp5.c ****         rslt = bmp5_get_regs(BMP5_REG_ODR_CONFIG, &reg_data, 1, dev);
 501:Core/Src/bmp5/bmp5.c **** 
 502:Core/Src/bmp5/bmp5.c ****         if (rslt == BMP5_OK)
 503:Core/Src/bmp5/bmp5.c ****         {
 504:Core/Src/bmp5/bmp5.c ****             pwrmode = BMP5_GET_BITS_POS_0(reg_data, BMP5_POWERMODE);
 505:Core/Src/bmp5/bmp5.c **** 
 506:Core/Src/bmp5/bmp5.c ****             switch (pwrmode)
 507:Core/Src/bmp5/bmp5.c ****             {
 508:Core/Src/bmp5/bmp5.c ****                 case BMP5_POWERMODE_STANDBY:
 509:Core/Src/bmp5/bmp5.c **** 
 510:Core/Src/bmp5/bmp5.c ****                     /* Getting deep disable status */
 511:Core/Src/bmp5/bmp5.c ****                     deep_dis = BMP5_GET_BITSLICE(reg_data, BMP5_DEEP_DISABLE);
 512:Core/Src/bmp5/bmp5.c **** 
 513:Core/Src/bmp5/bmp5.c ****                     /* Checking deepstandby status only when powermode is in standby mode */
 514:Core/Src/bmp5/bmp5.c **** 
 515:Core/Src/bmp5/bmp5.c ****                     /* If deep_dis = 0(BMP5_DEEP_ENABLED) then deepstandby mode is enabled.
 516:Core/Src/bmp5/bmp5.c ****                      * If deep_dis = 1(BMP5_DEEP_DISABLED) then deepstandby mode is disabled
