1597:Core/Src/bmp5/bmp5.c **** /*!
1598:Core/Src/bmp5/bmp5.c ****  * @brief This internal API is used to set sensor in standby or normal or forced or continous power
1599:Core/Src/bmp5/bmp5.c ****  */
1600:Core/Src/bmp5/bmp5.c **** static int8_t set_power_mode(enum bmp5_powermode powermode, bmp5_dev *dev)
