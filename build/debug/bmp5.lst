 551:Core/Src/bmp5/bmp5.c **** /*!
 552:Core/Src/bmp5/bmp5.c ****  *  @brief This API is used to set powermode of the sensor.
 553:Core/Src/bmp5/bmp5.c ****  */
 554:Core/Src/bmp5/bmp5.c **** int8_t bmp5_set_power_mode(enum bmp5_powermode powermode, bmp5_dev *dev)
 555:Core/Src/bmp5/bmp5.c **** {
 556:Core/Src/bmp5/bmp5.c ****     int8_t rslt;
 557:Core/Src/bmp5/bmp5.c ****     enum bmp5_powermode lst_pwrmode;
 558:Core/Src/bmp5/bmp5.c **** 
 559:Core/Src/bmp5/bmp5.c ****     /* Existing power mode of the device is received in lst_pwrmode */
 560:Core/Src/bmp5/bmp5.c ****     rslt = bmp5_get_power_mode(&lst_pwrmode, dev);
 561:Core/Src/bmp5/bmp5.c **** 
 562:Core/Src/bmp5/bmp5.c ****     if (rslt == BMP5_OK)
 563:Core/Src/bmp5/bmp5.c ****     {
 564:Core/Src/bmp5/bmp5.c ****         /* If the sensor is not in standby mode set the device to
 565:Core/Src/bmp5/bmp5.c ****          *  standby mode.
 566:Core/Src/bmp5/bmp5.c ****          */
 567:Core/Src/bmp5/bmp5.c ****         if (lst_pwrmode != BMP5_POWERMODE_STANDBY)
 568:Core/Src/bmp5/bmp5.c ****         {
 569:Core/Src/bmp5/bmp5.c ****             /* Device should be set to standby before transiting to
 570:Core/Src/bmp5/bmp5.c ****              * forced mode or normal mode or continous mode.
 571:Core/Src/bmp5/bmp5.c ****              */
 572:Core/Src/bmp5/bmp5.c ****             rslt = set_power_mode(BMP5_POWERMODE_STANDBY, dev);
 573:Core/Src/bmp5/bmp5.c **** 
 574:Core/Src/bmp5/bmp5.c ****             if (rslt == BMP5_OK)
 575:Core/Src/bmp5/bmp5.c ****             {
 576:Core/Src/bmp5/bmp5.c ****                 /* Give t_standby(as per data sheet) time for device to go into standby mode */
 577:Core/Src/bmp5/bmp5.c ****                 dev->delay_us(BMP5_DELAY_US_STANDBY, dev->intf_ptr);
 578:Core/Src/bmp5/bmp5.c ****             }
 579:Core/Src/bmp5/bmp5.c ****         }
 580:Core/Src/bmp5/bmp5.c **** 
 581:Core/Src/bmp5/bmp5.c ****         /* Set the desired power mode */
