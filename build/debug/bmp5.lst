2086:Core/Src/bmp5/bmp5.c ****     {
2087:Core/Src/bmp5/bmp5.c ****         rslt = get_nvm_status(&nvm_status, dev);
2088:Core/Src/bmp5/bmp5.c **** 
2089:Core/Src/bmp5/bmp5.c ****         /* Check if NVM ready status = 1, NVM error status = 0 and NVM command error status = 0 */
2090:Core/Src/bmp5/bmp5.c ****         if ((nvm_status & BMP5_INT_NVM_RDY) && (!(nvm_status & BMP5_INT_NVM_ERR)) &&
2091:Core/Src/bmp5/bmp5.c ****             (!(nvm_status & BMP5_INT_NVM_CMD_ERR)))
2092:Core/Src/bmp5/bmp5.c ****         {
2093:Core/Src/bmp5/bmp5.c ****             /* Read the NVM data from the register address */
2094:Core/Src/bmp5/bmp5.c ****             rslt = bmp5_get_regs(BMP5_REG_NVM_DATA_LSB, nvmdata, 2, dev);
2095:Core/Src/bmp5/bmp5.c **** 
2096:Core/Src/bmp5/bmp5.c ****             (*nvm_data) = (uint16_t)((nvmdata[1] << 8) | nvmdata[0]);
2097:Core/Src/bmp5/bmp5.c ****         }
2098:Core/Src/bmp5/bmp5.c ****         else
2099:Core/Src/bmp5/bmp5.c ****         {
