1927:Core/Src/bmp5/bmp5.c ****  *  @brief This internal API sets the IIR configuration and count limit of OOR pressure.
1928:Core/Src/bmp5/bmp5.c ****  */
1929:Core/Src/bmp5/bmp5.c **** static int8_t set_oor_iir_count_limit(uint8_t set_oor_iir_p, uint8_t set_count_limit, bmp5_dev *dev
1930:Core/Src/bmp5/bmp5.c **** {
1931:Core/Src/bmp5/bmp5.c ****     int8_t rslt;
