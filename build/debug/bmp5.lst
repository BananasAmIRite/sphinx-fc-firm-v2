1540:Core/Src/bmp5/bmp5.c **** /*!
1541:Core/Src/bmp5/bmp5.c ****  * @brief This internal API is used to set sensor in deep standby mode.
1542:Core/Src/bmp5/bmp5.c ****  */
1543:Core/Src/bmp5/bmp5.c **** static int8_t set_deep_standby_mode(bmp5_dev *dev)
1544:Core/Src/bmp5/bmp5.c **** {
1545:Core/Src/bmp5/bmp5.c ****     int8_t rslt;
1546:Core/Src/bmp5/bmp5.c ****     uint8_t reg_data;
1547:Core/Src/bmp5/bmp5.c **** 
1548:Core/Src/bmp5/bmp5.c ****     rslt = bmp5_get_regs(BMP5_REG_ODR_CONFIG, &reg_data, 1, dev);
1549:Core/Src/bmp5/bmp5.c **** 
1550:Core/Src/bmp5/bmp5.c ****     if (rslt == BMP5_OK)
1551:Core/Src/bmp5/bmp5.c ****     {
1552:Core/Src/bmp5/bmp5.c ****         /* Setting deep_dis = 0(BMP5_DEEP_ENABLED) enables the deep standby mode */
1553:Core/Src/bmp5/bmp5.c ****         reg_data = BMP5_SET_BIT_VAL_0(reg_data, BMP5_DEEP_DISABLE);
1554:Core/Src/bmp5/bmp5.c **** 
1555:Core/Src/bmp5/bmp5.c ****         /* Set ODR less then 5Hz - ODR used is 1Hz */
1556:Core/Src/bmp5/bmp5.c ****         reg_data = BMP5_SET_BITSLICE(reg_data, BMP5_ODR, BMP5_ODR_01_HZ);
1557:Core/Src/bmp5/bmp5.c **** 
1558:Core/Src/bmp5/bmp5.c ****         /* Write the value to the odr config register(0x37) */
1559:Core/Src/bmp5/bmp5.c ****         rslt = bmp5_set_regs(BMP5_REG_ODR_CONFIG, &reg_data, 1, dev);
1560:Core/Src/bmp5/bmp5.c **** 
1561:Core/Src/bmp5/bmp5.c ****         if (rslt == BMP5_OK)
1562:Core/Src/bmp5/bmp5.c ****         {
1563:Core/Src/bmp5/bmp5.c ****             rslt = bmp5_get_regs(BMP5_REG_DSP_IIR, &reg_data, 1, dev);
1564:Core/Src/bmp5/bmp5.c **** 
1565:Core/Src/bmp5/bmp5.c ****             if (rslt == BMP5_OK)
1566:Core/Src/bmp5/bmp5.c ****             {
1567:Core/Src/bmp5/bmp5.c ****                 /* Set iir_t and iir_p as Bypass(0x00) */
1568:Core/Src/bmp5/bmp5.c **** 
1569:Core/Src/bmp5/bmp5.c ****                 /* The register holds only iir_t and iir_p and the last 2 bits are reserved.
1570:Core/Src/bmp5/bmp5.c ****                  * Thus using the macro BMP5_IIR_BYPASS(0xC0) the register value is set as zero.
1571:Core/Src/bmp5/bmp5.c ****                  */
1572:Core/Src/bmp5/bmp5.c ****                 reg_data = reg_data & BMP5_IIR_BYPASS;
1573:Core/Src/bmp5/bmp5.c **** 
ARM GAS  C:\Users\jason\AppData\Local\Temp\ccKYcdsQ.s 			page 31


1574:Core/Src/bmp5/bmp5.c ****                 /* Write the value to the IIR register(0x31) */
1575:Core/Src/bmp5/bmp5.c ****                 rslt = bmp5_set_regs(BMP5_REG_DSP_IIR, &reg_data, 1, dev);
1576:Core/Src/bmp5/bmp5.c ****             }
1577:Core/Src/bmp5/bmp5.c ****         }
1578:Core/Src/bmp5/bmp5.c **** 
1579:Core/Src/bmp5/bmp5.c ****         if (rslt == BMP5_OK)
1580:Core/Src/bmp5/bmp5.c ****         {
1581:Core/Src/bmp5/bmp5.c ****             rslt = bmp5_get_regs(BMP5_REG_FIFO_SEL, &reg_data, 1, dev);
1582:Core/Src/bmp5/bmp5.c **** 
1583:Core/Src/bmp5/bmp5.c ****             if (rslt == BMP5_OK)
1584:Core/Src/bmp5/bmp5.c ****             {
1585:Core/Src/bmp5/bmp5.c ****                 /* Disable fifo frame selct */
1586:Core/Src/bmp5/bmp5.c ****                 reg_data = BMP5_SET_BIT_VAL_0(reg_data, BMP5_FIFO_FRAME_SEL);
1587:Core/Src/bmp5/bmp5.c **** 
1588:Core/Src/bmp5/bmp5.c ****                 /* Write the value to the fifo select register(0x18) */
1589:Core/Src/bmp5/bmp5.c ****                 rslt = bmp5_set_regs(BMP5_REG_FIFO_SEL, &reg_data, 1, dev);
1590:Core/Src/bmp5/bmp5.c ****             }
1591:Core/Src/bmp5/bmp5.c ****         }
1592:Core/Src/bmp5/bmp5.c ****     }
1593:Core/Src/bmp5/bmp5.c **** 
1594:Core/Src/bmp5/bmp5.c ****     return rslt;
1595:Core/Src/bmp5/bmp5.c **** }
