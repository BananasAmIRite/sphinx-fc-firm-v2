2101:Core/Src/bmp5/bmp5.c ****         }
2102:Core/Src/bmp5/bmp5.c ****     }
2103:Core/Src/bmp5/bmp5.c ****     else
2104:Core/Src/bmp5/bmp5.c ****     {
2105:Core/Src/bmp5/bmp5.c ****         rslt = BMP5_E_NULL_PTR;
2106:Core/Src/bmp5/bmp5.c ****     }
2107:Core/Src/bmp5/bmp5.c **** 
2108:Core/Src/bmp5/bmp5.c ****     return rslt;
2109:Core/Src/bmp5/bmp5.c **** }
