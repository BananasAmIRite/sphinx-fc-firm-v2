 272:Core/Src/bmp5/bmp5.c ****  * @return Result of API execution status
 273:Core/Src/bmp5/bmp5.c ****  * @retval 0 -> Success
 274:Core/Src/bmp5/bmp5.c ****  * @retval <0 -> Fail
 275:Core/Src/bmp5/bmp5.c ****  */
 276:Core/Src/bmp5/bmp5.c **** static int8_t set_nvm_addr(uint8_t nvm_addr, uint8_t prog_en, bmp5_dev *dev);
