 282:Core/Src/bmp5/bmp5.c **** 
 283:Core/Src/bmp5/bmp5.c **** /*!
 284:Core/Src/bmp5/bmp5.c **** *  @brief This API is the entry point.
 285:Core/Src/bmp5/bmp5.c **** *  It performs the selection of I2C/I3C/SPI read mechanism according to the
 286:Core/Src/bmp5/bmp5.c **** *  selected interface and reads the chip-id of the sensor.
 287:Core/Src/bmp5/bmp5.c **** */
 288:Core/Src/bmp5/bmp5.c **** int8_t bmp5_init(bmp5_dev *dev)
 289:Core/Src/bmp5/bmp5.c **** {
 290:Core/Src/bmp5/bmp5.c ****     int8_t rslt;
 291:Core/Src/bmp5/bmp5.c ****     uint8_t reg_data;
 292:Core/Src/bmp5/bmp5.c ****     uint8_t chip_id;
 293:Core/Src/bmp5/bmp5.c **** 
 294:Core/Src/bmp5/bmp5.c ****     /* Check for null pointer in the device structure */
 295:Core/Src/bmp5/bmp5.c ****     rslt = null_ptr_check(dev);
 296:Core/Src/bmp5/bmp5.c **** 
 297:Core/Src/bmp5/bmp5.c ****     if (rslt == BMP5_OK)
 298:Core/Src/bmp5/bmp5.c ****     {
 299:Core/Src/bmp5/bmp5.c ****         if (dev->intf == BMP5_SPI_INTF)
 300:Core/Src/bmp5/bmp5.c ****         {
 301:Core/Src/bmp5/bmp5.c ****             /* Performing a single read via SPI of registers,
 302:Core/Src/bmp5/bmp5.c ****              * e.g. registers CHIP_ID, before the actual
 303:Core/Src/bmp5/bmp5.c ****              * SPI communication with the device.
 304:Core/Src/bmp5/bmp5.c ****              */
 305:Core/Src/bmp5/bmp5.c ****             rslt = bmp5_get_regs(BMP5_REG_CHIP_ID, &reg_data, 1, dev);
 306:Core/Src/bmp5/bmp5.c ****         }
 307:Core/Src/bmp5/bmp5.c **** 
 308:Core/Src/bmp5/bmp5.c ****         if (rslt == BMP5_OK)
 309:Core/Src/bmp5/bmp5.c ****         {
 310:Core/Src/bmp5/bmp5.c ****             /* Read chip_id */
 311:Core/Src/bmp5/bmp5.c ****             rslt = bmp5_get_regs(BMP5_REG_CHIP_ID, &chip_id, 1, dev);
 312:Core/Src/bmp5/bmp5.c **** 
 313:Core/Src/bmp5/bmp5.c ****             if (rslt == BMP5_OK)
 314:Core/Src/bmp5/bmp5.c ****             {
 315:Core/Src/bmp5/bmp5.c ****                 if (chip_id != 0)
 316:Core/Src/bmp5/bmp5.c ****                 {
ARM GAS  C:\Users\jason\AppData\Local\Temp\ccKYcdsQ.s 			page 7


 317:Core/Src/bmp5/bmp5.c ****                     /* Validate post power-up procedure */
 318:Core/Src/bmp5/bmp5.c ****                     rslt = power_up_check(dev);
 319:Core/Src/bmp5/bmp5.c ****                 }
 320:Core/Src/bmp5/bmp5.c ****                 else
 321:Core/Src/bmp5/bmp5.c ****                 {
 322:Core/Src/bmp5/bmp5.c ****                     rslt = BMP5_E_INVALID_CHIP_ID;
 323:Core/Src/bmp5/bmp5.c ****                 }
 324:Core/Src/bmp5/bmp5.c **** 
 325:Core/Src/bmp5/bmp5.c ****                 if (rslt == BMP5_OK)
 326:Core/Src/bmp5/bmp5.c ****                 {
 327:Core/Src/bmp5/bmp5.c ****                     rslt = validate_chip_id(chip_id, dev);
 328:Core/Src/bmp5/bmp5.c ****                 }
 329:Core/Src/bmp5/bmp5.c ****             }
 330:Core/Src/bmp5/bmp5.c ****         }
 331:Core/Src/bmp5/bmp5.c ****     }
 332:Core/Src/bmp5/bmp5.c **** 
 333:Core/Src/bmp5/bmp5.c ****     return rslt;
 334:Core/Src/bmp5/bmp5.c **** }
 335:Core/Src/bmp5/bmp5.c **** 
 336:Core/Src/bmp5/bmp5.c **** /*!
 337:Core/Src/bmp5/bmp5.c ****  * @brief This API reads the data from the given register address of the sensor.
 338:Core/Src/bmp5/bmp5.c ****  */
 339:Core/Src/bmp5/bmp5.c **** int8_t bmp5_get_regs(uint8_t reg_addr, uint8_t *reg_data, uint32_t len, bmp5_dev *dev)
 340:Core/Src/bmp5/bmp5.c **** {
 341:Core/Src/bmp5/bmp5.c ****     int8_t rslt;
 342:Core/Src/bmp5/bmp5.c **** 
 343:Core/Src/bmp5/bmp5.c ****     /* Check for null pointer in the device structure */
 344:Core/Src/bmp5/bmp5.c ****     rslt = null_ptr_check(dev);
 345:Core/Src/bmp5/bmp5.c **** 
 346:Core/Src/bmp5/bmp5.c ****     /* Proceed if null check is fine */
 347:Core/Src/bmp5/bmp5.c ****     if ((rslt == BMP5_OK) && (reg_data != NULL))
 348:Core/Src/bmp5/bmp5.c ****     {
 349:Core/Src/bmp5/bmp5.c ****         if (dev->intf == BMP5_SPI_INTF)
 350:Core/Src/bmp5/bmp5.c ****         {
 351:Core/Src/bmp5/bmp5.c ****             /* If interface selected is SPI */
 352:Core/Src/bmp5/bmp5.c ****             reg_addr = reg_addr | BMP5_SPI_RD_MASK;
 353:Core/Src/bmp5/bmp5.c ****         }
 354:Core/Src/bmp5/bmp5.c **** 
 355:Core/Src/bmp5/bmp5.c ****         /* Read the data from the reg_addr */
 356:Core/Src/bmp5/bmp5.c ****         dev->intf_rslt = dev->read(reg_addr, reg_data, len, dev->intf_ptr);
 357:Core/Src/bmp5/bmp5.c **** 
 358:Core/Src/bmp5/bmp5.c ****         if (dev->intf_rslt != BMP5_INTF_RET_SUCCESS)
 359:Core/Src/bmp5/bmp5.c ****         {
 360:Core/Src/bmp5/bmp5.c ****             /* Failure case */
 361:Core/Src/bmp5/bmp5.c ****             rslt = BMP5_E_COM_FAIL;
 362:Core/Src/bmp5/bmp5.c ****         }
 363:Core/Src/bmp5/bmp5.c ****     }
 364:Core/Src/bmp5/bmp5.c ****     else
 365:Core/Src/bmp5/bmp5.c ****     {
 366:Core/Src/bmp5/bmp5.c ****         rslt = BMP5_E_NULL_PTR;
 367:Core/Src/bmp5/bmp5.c ****     }
 368:Core/Src/bmp5/bmp5.c **** 
 369:Core/Src/bmp5/bmp5.c ****     return rslt;
 370:Core/Src/bmp5/bmp5.c **** }
 371:Core/Src/bmp5/bmp5.c **** 
 372:Core/Src/bmp5/bmp5.c **** /*!
 373:Core/Src/bmp5/bmp5.c ****  * @brief This API writes the given data to the register address
ARM GAS  C:\Users\jason\AppData\Local\Temp\ccKYcdsQ.s 			page 8


 374:Core/Src/bmp5/bmp5.c ****  * of the sensor.
 375:Core/Src/bmp5/bmp5.c ****  */
 376:Core/Src/bmp5/bmp5.c **** int8_t bmp5_set_regs(uint8_t reg_addr, const uint8_t *reg_data, uint32_t len, bmp5_dev *dev)
 377:Core/Src/bmp5/bmp5.c **** {
 378:Core/Src/bmp5/bmp5.c ****     int8_t rslt;
 379:Core/Src/bmp5/bmp5.c ****     uint8_t idx = 0;
 380:Core/Src/bmp5/bmp5.c **** 
 381:Core/Src/bmp5/bmp5.c ****     /* Check for null pointer in the device structure */
 382:Core/Src/bmp5/bmp5.c ****     rslt = null_ptr_check(dev);
 383:Core/Src/bmp5/bmp5.c **** 
 384:Core/Src/bmp5/bmp5.c ****     /* Proceed if null check is fine */
 385:Core/Src/bmp5/bmp5.c ****     if ((rslt == BMP5_OK) && (reg_data != NULL))
 386:Core/Src/bmp5/bmp5.c ****     {
 387:Core/Src/bmp5/bmp5.c ****         if (dev->intf == BMP5_SPI_INTF)
 388:Core/Src/bmp5/bmp5.c ****         {
 389:Core/Src/bmp5/bmp5.c ****             /* Write the data to the reg_addr */
 390:Core/Src/bmp5/bmp5.c ****             do
 391:Core/Src/bmp5/bmp5.c ****             {
 392:Core/Src/bmp5/bmp5.c ****                 dev->intf_rslt = dev->write((reg_addr + idx), &reg_data[idx], 1, dev->intf_ptr);
 393:Core/Src/bmp5/bmp5.c ****                 idx++;
 394:Core/Src/bmp5/bmp5.c ****             } while ((idx < len) && (dev->intf_rslt == BMP5_INTF_RET_SUCCESS));
 395:Core/Src/bmp5/bmp5.c ****         }
 396:Core/Src/bmp5/bmp5.c ****         else if ((dev->intf == BMP5_I2C_INTF) || (dev->intf == BMP5_I3C_INTF))
 397:Core/Src/bmp5/bmp5.c ****         {
 398:Core/Src/bmp5/bmp5.c ****             /* Write the data to the reg_addr */
 399:Core/Src/bmp5/bmp5.c ****             dev->intf_rslt = dev->write(reg_addr, reg_data, len, dev->intf_ptr);
 400:Core/Src/bmp5/bmp5.c ****         }
 401:Core/Src/bmp5/bmp5.c **** 
 402:Core/Src/bmp5/bmp5.c ****         if (dev->intf_rslt != BMP5_INTF_RET_SUCCESS)
 403:Core/Src/bmp5/bmp5.c ****         {
 404:Core/Src/bmp5/bmp5.c ****             /* Failure case */
 405:Core/Src/bmp5/bmp5.c ****             rslt = BMP5_E_COM_FAIL;
 406:Core/Src/bmp5/bmp5.c ****         }
 407:Core/Src/bmp5/bmp5.c ****     }
 408:Core/Src/bmp5/bmp5.c ****     else
 409:Core/Src/bmp5/bmp5.c ****     {
 410:Core/Src/bmp5/bmp5.c ****         rslt = BMP5_E_NULL_PTR;
 411:Core/Src/bmp5/bmp5.c ****     }
 412:Core/Src/bmp5/bmp5.c **** 
 413:Core/Src/bmp5/bmp5.c ****     return rslt;
 414:Core/Src/bmp5/bmp5.c **** }
 415:Core/Src/bmp5/bmp5.c **** 
 416:Core/Src/bmp5/bmp5.c **** /*!
 417:Core/Src/bmp5/bmp5.c ****  * @brief This API performs the soft reset of the sensor.
 418:Core/Src/bmp5/bmp5.c ****  */
 419:Core/Src/bmp5/bmp5.c **** int8_t bmp5_soft_reset(bmp5_dev *dev)
 420:Core/Src/bmp5/bmp5.c **** {
 421:Core/Src/bmp5/bmp5.c ****     int8_t rslt;
 422:Core/Src/bmp5/bmp5.c ****     uint8_t reg_data;
