1990:Core/Src/bmp5/bmp5.c ****             }
1991:Core/Src/bmp5/bmp5.c ****         }
1992:Core/Src/bmp5/bmp5.c ****     }
1993:Core/Src/bmp5/bmp5.c **** 
1994:Core/Src/bmp5/bmp5.c ****     return rslt;
1995:Core/Src/bmp5/bmp5.c **** }
