2079:Core/Src/bmp5/bmp5.c **** static int8_t get_nvm_data(uint16_t *nvm_data, bmp5_dev *dev)
2080:Core/Src/bmp5/bmp5.c **** {
2081:Core/Src/bmp5/bmp5.c ****     int8_t rslt;
