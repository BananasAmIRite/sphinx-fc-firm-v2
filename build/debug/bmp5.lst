1971:Core/Src/bmp5/bmp5.c **** 
1972:Core/Src/bmp5/bmp5.c ****             if (rslt == BMP5_OK)
1973:Core/Src/bmp5/bmp5.c ****             {
1974:Core/Src/bmp5/bmp5.c ****                 /* Set OOR pressure count limit */
1975:Core/Src/bmp5/bmp5.c ****                 rslt = bmp5_set_regs(BMP5_REG_OOR_CONFIG, &reg_data, 1, dev);
1976:Core/Src/bmp5/bmp5.c ****             }
1977:Core/Src/bmp5/bmp5.c ****         }
1978:Core/Src/bmp5/bmp5.c **** 
1979:Core/Src/bmp5/bmp5.c ****         /* If previous mode is not standbymode return sensor to that previous mode
1980:Core/Src/bmp5/bmp5.c ****          * after setting oor iir configuration and count limit
1981:Core/Src/bmp5/bmp5.c ****          */
1982:Core/Src/bmp5/bmp5.c ****         if (rslt == BMP5_OK)
1983:Core/Src/bmp5/bmp5.c ****         {
1984:Core/Src/bmp5/bmp5.c ****             /* Since oor IIR and count limit works only in standby mode we are not re-writing to de
1985:Core/Src/bmp5/bmp5.c ****              * as deep standby mode resets the oor iir configuration and count limit to default
1986:Core/Src/bmp5/bmp5.c ****              */
1987:Core/Src/bmp5/bmp5.c ****             if ((curr_pwrmode != BMP5_POWERMODE_STANDBY) && (curr_pwrmode != BMP5_POWERMODE_DEEP_ST
1988:Core/Src/bmp5/bmp5.c ****             {
