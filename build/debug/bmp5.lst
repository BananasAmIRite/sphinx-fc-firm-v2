1935:Core/Src/bmp5/bmp5.c ****     enum bmp5_powermode curr_pwrmode;
1936:Core/Src/bmp5/bmp5.c **** 
1937:Core/Src/bmp5/bmp5.c ****     rslt = bmp5_get_power_mode(&curr_pwrmode, dev);
1938:Core/Src/bmp5/bmp5.c **** 
1939:Core/Src/bmp5/bmp5.c ****     if (rslt == BMP5_OK)
1940:Core/Src/bmp5/bmp5.c ****     {
1941:Core/Src/bmp5/bmp5.c ****         /* OOR IIR configuration and count limit is writable only during STANDBY mode(as per datash
1942:Core/Src/bmp5/bmp5.c ****         if (curr_pwrmode != BMP5_POWERMODE_STANDBY)
1943:Core/Src/bmp5/bmp5.c ****         {
1944:Core/Src/bmp5/bmp5.c ****             /* If sensor is not in standby mode, set sensor in standby mode */
1945:Core/Src/bmp5/bmp5.c ****             rslt = bmp5_set_power_mode(BMP5_POWERMODE_STANDBY, dev);
1946:Core/Src/bmp5/bmp5.c ****         }
1947:Core/Src/bmp5/bmp5.c **** 
1948:Core/Src/bmp5/bmp5.c ****         if (rslt == BMP5_OK)
1949:Core/Src/bmp5/bmp5.c ****         {
1950:Core/Src/bmp5/bmp5.c ****             /* Get OOR pressure IIR configuration */
1951:Core/Src/bmp5/bmp5.c ****             rslt = bmp5_get_regs(BMP5_REG_DSP_CONFIG, &reg_data, 1, dev);
1952:Core/Src/bmp5/bmp5.c **** 
1953:Core/Src/bmp5/bmp5.c ****             if (rslt == BMP5_OK)
1954:Core/Src/bmp5/bmp5.c ****             {
1955:Core/Src/bmp5/bmp5.c ****                 reg_data = BMP5_SET_BITSLICE(reg_data, BMP5_OOR_SEL_IIR_PRESS, set_oor_iir_p);
1956:Core/Src/bmp5/bmp5.c **** 
1957:Core/Src/bmp5/bmp5.c ****                 /* Set OOR pressure IIR configuration */
1958:Core/Src/bmp5/bmp5.c ****                 rslt = bmp5_set_regs(BMP5_REG_DSP_CONFIG, &reg_data, 1, dev);
1959:Core/Src/bmp5/bmp5.c ****             }
1960:Core/Src/bmp5/bmp5.c **** 
1961:Core/Src/bmp5/bmp5.c ****             if (rslt == BMP5_OK)
1962:Core/Src/bmp5/bmp5.c ****             {
1963:Core/Src/bmp5/bmp5.c ****                 /* Get OOR pressure count limit */
1964:Core/Src/bmp5/bmp5.c ****                 rslt = bmp5_get_regs(BMP5_REG_OOR_CONFIG, &reg_data, 1, dev);
1965:Core/Src/bmp5/bmp5.c ****             }
1966:Core/Src/bmp5/bmp5.c **** 
1967:Core/Src/bmp5/bmp5.c ****             if (rslt == BMP5_OK)
1968:Core/Src/bmp5/bmp5.c ****             {
ARM GAS  C:\Users\jason\AppData\Local\Temp\ccKYcdsQ.s 			page 49


1969:Core/Src/bmp5/bmp5.c ****                 reg_data = BMP5_SET_BITSLICE(reg_data, BMP5_OOR_COUNT_LIMIT, set_count_limit);
