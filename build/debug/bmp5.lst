2033:Core/Src/bmp5/bmp5.c **** /*!
2034:Core/Src/bmp5/bmp5.c ****  * @brief This internal API is used to set the nvm address and prog_enable based on NVM read/write 
2035:Core/Src/bmp5/bmp5.c ****  */
2036:Core/Src/bmp5/bmp5.c **** static int8_t set_nvm_addr(uint8_t nvm_addr, uint8_t prog_en, bmp5_dev *dev)
2037:Core/Src/bmp5/bmp5.c **** {
2038:Core/Src/bmp5/bmp5.c ****     int8_t rslt;
2039:Core/Src/bmp5/bmp5.c ****     uint8_t nvm_status;
2040:Core/Src/bmp5/bmp5.c ****     uint8_t reg_data;
2041:Core/Src/bmp5/bmp5.c **** 
2042:Core/Src/bmp5/bmp5.c ****     /* Check if NVM ready status = 1 */
2043:Core/Src/bmp5/bmp5.c ****     rslt = get_nvm_status(&nvm_status, dev);
2044:Core/Src/bmp5/bmp5.c **** 
2045:Core/Src/bmp5/bmp5.c ****     if (nvm_status & BMP5_INT_NVM_RDY)
2046:Core/Src/bmp5/bmp5.c ****     {
2047:Core/Src/bmp5/bmp5.c ****         rslt = bmp5_get_regs(BMP5_REG_NVM_ADDR, &reg_data, 1, dev);
2048:Core/Src/bmp5/bmp5.c **** 
2049:Core/Src/bmp5/bmp5.c ****         if (rslt == BMP5_OK)
2050:Core/Src/bmp5/bmp5.c ****         {
2051:Core/Src/bmp5/bmp5.c ****             /* Write the NVM address */
2052:Core/Src/bmp5/bmp5.c ****             reg_data = BMP5_SET_BITS_POS_0(reg_data, BMP5_NVM_ADDR, nvm_addr);
2053:Core/Src/bmp5/bmp5.c **** 
2054:Core/Src/bmp5/bmp5.c ****             if (prog_en == BMP5_ENABLE)
2055:Core/Src/bmp5/bmp5.c ****             {
2056:Core/Src/bmp5/bmp5.c ****                 /* Set bit nvm_prog_en as 1 if NVM write is selected */
2057:Core/Src/bmp5/bmp5.c ****                 reg_data = BMP5_SET_BITSLICE(reg_data, BMP5_NVM_PROG_EN, prog_en);
2058:Core/Src/bmp5/bmp5.c ****             }
2059:Core/Src/bmp5/bmp5.c ****             else
2060:Core/Src/bmp5/bmp5.c ****             {
2061:Core/Src/bmp5/bmp5.c ****                 /* Set bit nvm_prog_en as 0 if NVM read is selected */
2062:Core/Src/bmp5/bmp5.c ****                 reg_data = BMP5_SET_BIT_VAL_0(reg_data, BMP5_NVM_PROG_EN);
2063:Core/Src/bmp5/bmp5.c ****             }
2064:Core/Src/bmp5/bmp5.c **** 
2065:Core/Src/bmp5/bmp5.c ****             rslt = bmp5_set_regs(BMP5_REG_NVM_ADDR, &reg_data, 1, dev);
2066:Core/Src/bmp5/bmp5.c ****         }
2067:Core/Src/bmp5/bmp5.c ****     }
2068:Core/Src/bmp5/bmp5.c ****     else
2069:Core/Src/bmp5/bmp5.c ****     {
2070:Core/Src/bmp5/bmp5.c ****         rslt = BMP5_E_NVM_NOT_READY;
2071:Core/Src/bmp5/bmp5.c ****     }
2072:Core/Src/bmp5/bmp5.c **** 
2073:Core/Src/bmp5/bmp5.c ****     return rslt;
2074:Core/Src/bmp5/bmp5.c **** }
