 589:Core/Src/bmp5/bmp5.c ****                 case BMP5_POWERMODE_STANDBY:
 590:Core/Src/bmp5/bmp5.c **** 
 591:Core/Src/bmp5/bmp5.c ****                     /* Since switching between powermodes require sensor to be in standby mode
 592:Core/Src/bmp5/bmp5.c ****                      * it is performed above. So it is not explicitly performed here.
 593:Core/Src/bmp5/bmp5.c ****                      */
 594:Core/Src/bmp5/bmp5.c ****                     break;
 595:Core/Src/bmp5/bmp5.c ****                 case BMP5_POWERMODE_NORMAL:
 596:Core/Src/bmp5/bmp5.c ****                 case BMP5_POWERMODE_FORCED:
 597:Core/Src/bmp5/bmp5.c ****                 case BMP5_POWERMODE_CONTINOUS:
 598:Core/Src/bmp5/bmp5.c ****                     rslt = set_power_mode(powermode, dev);
 599:Core/Src/bmp5/bmp5.c ****                     break;
 600:Core/Src/bmp5/bmp5.c ****                 default:
 601:Core/Src/bmp5/bmp5.c ****                     rslt = BMP5_E_INVALID_POWERMODE;
