 702:Core/Src/bmp5/bmp5.c **** /*!
 703:Core/Src/bmp5/bmp5.c **** * @brief This API is used to configure the interrupt settings.
 704:Core/Src/bmp5/bmp5.c **** */
 705:Core/Src/bmp5/bmp5.c **** int8_t bmp5_configure_interrupt(enum bmp5_intr_mode int_mode,
 706:Core/Src/bmp5/bmp5.c ****                                 enum bmp5_intr_polarity int_pol,
 707:Core/Src/bmp5/bmp5.c ****                                 enum bmp5_intr_drive int_od,
 708:Core/Src/bmp5/bmp5.c ****                                 enum bmp5_intr_en_dis int_en,
 709:Core/Src/bmp5/bmp5.c ****                                 bmp5_dev *dev)
 710:Core/Src/bmp5/bmp5.c **** {
 711:Core/Src/bmp5/bmp5.c ****     /* Variable to store the function result */
 712:Core/Src/bmp5/bmp5.c ****     int8_t rslt;
 713:Core/Src/bmp5/bmp5.c **** 
 714:Core/Src/bmp5/bmp5.c ****     /* Variable to get interrupt configuration */
 715:Core/Src/bmp5/bmp5.c ****     uint8_t reg_data = 0;
ARM GAS  C:\Users\jason\AppData\Local\Temp\ccKYcdsQ.s 			page 14


 716:Core/Src/bmp5/bmp5.c **** 
 717:Core/Src/bmp5/bmp5.c ****     /* Variable to set interrupt source */
 718:Core/Src/bmp5/bmp5.c ****     uint8_t int_source = 0;
 719:Core/Src/bmp5/bmp5.c **** 
 720:Core/Src/bmp5/bmp5.c ****     /* Variable to get interrupt status */
 721:Core/Src/bmp5/bmp5.c ****     uint8_t int_status = 0;
 722:Core/Src/bmp5/bmp5.c **** 
 723:Core/Src/bmp5/bmp5.c ****     /* Get interrupt configuration */
 724:Core/Src/bmp5/bmp5.c ****     rslt = bmp5_get_regs(BMP5_REG_INT_CONFIG, &reg_data, 1, dev);
 725:Core/Src/bmp5/bmp5.c **** 
 726:Core/Src/bmp5/bmp5.c ****     if (rslt == BMP5_OK)
 727:Core/Src/bmp5/bmp5.c ****     {
 728:Core/Src/bmp5/bmp5.c ****         /* Any change between latched/pulsed mode has to be applied while interrupt is disabled */
 729:Core/Src/bmp5/bmp5.c ****         /* Step 1 : Turn off all INT sources (INT_SOURCE -> 0x00) */
 730:Core/Src/bmp5/bmp5.c ****         rslt = bmp5_set_regs(BMP5_REG_INT_SOURCE, &int_source, 1, dev);
 731:Core/Src/bmp5/bmp5.c **** 
 732:Core/Src/bmp5/bmp5.c ****         if (rslt == BMP5_OK)
 733:Core/Src/bmp5/bmp5.c ****         {
 734:Core/Src/bmp5/bmp5.c ****             /* Step 2 : Read the INT_STATUS register to clear the status */
 735:Core/Src/bmp5/bmp5.c ****             rslt = bmp5_get_regs(BMP5_REG_INT_STATUS, &int_status, 1, dev);
 736:Core/Src/bmp5/bmp5.c **** 
 737:Core/Src/bmp5/bmp5.c ****             if (rslt == BMP5_OK)
 738:Core/Src/bmp5/bmp5.c ****             {
 739:Core/Src/bmp5/bmp5.c ****                 /* Step 3 : Set the desired mode in INT_CONFIG.int_mode */
 740:Core/Src/bmp5/bmp5.c ****                 reg_data = BMP5_SET_BITS_POS_0(reg_data, BMP5_INT_MODE, int_mode);
 741:Core/Src/bmp5/bmp5.c ****                 reg_data = BMP5_SET_BITSLICE(reg_data, BMP5_INT_POL, int_pol);
 742:Core/Src/bmp5/bmp5.c ****                 reg_data = BMP5_SET_BITSLICE(reg_data, BMP5_INT_OD, int_od);
 743:Core/Src/bmp5/bmp5.c ****                 reg_data = BMP5_SET_BITSLICE(reg_data, BMP5_INT_EN, int_en);
 744:Core/Src/bmp5/bmp5.c **** 
 745:Core/Src/bmp5/bmp5.c ****                 /* Finally transfer the interrupt configurations */
 746:Core/Src/bmp5/bmp5.c ****                 rslt = bmp5_set_regs(BMP5_REG_INT_CONFIG, &reg_data, 1, dev);
 747:Core/Src/bmp5/bmp5.c ****             }
 748:Core/Src/bmp5/bmp5.c ****         }
 749:Core/Src/bmp5/bmp5.c ****     }
 750:Core/Src/bmp5/bmp5.c **** 
 751:Core/Src/bmp5/bmp5.c ****     return rslt;
 752:Core/Src/bmp5/bmp5.c **** }
