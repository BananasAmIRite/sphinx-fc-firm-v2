 430:Core/Src/bmp5/bmp5.c ****     {
ARM GAS  C:\Users\jason\AppData\Local\Temp\ccKYcdsQ.s 			page 9


 431:Core/Src/bmp5/bmp5.c ****         /* Soft-reset execution takes 2 ms */
 432:Core/Src/bmp5/bmp5.c ****         dev->delay_us(BMP5_DELAY_US_SOFT_RESET, dev->intf_ptr);
 433:Core/Src/bmp5/bmp5.c **** 
 434:Core/Src/bmp5/bmp5.c ****         if (dev->intf == BMP5_SPI_INTF)
 435:Core/Src/bmp5/bmp5.c ****         {
 436:Core/Src/bmp5/bmp5.c ****             /* Performing a single read via SPI of registers,
 437:Core/Src/bmp5/bmp5.c ****             * e.g. registers CHIP_ID, before the actual
 438:Core/Src/bmp5/bmp5.c ****             * SPI communication with the device.
 439:Core/Src/bmp5/bmp5.c ****             */
 440:Core/Src/bmp5/bmp5.c ****             rslt = bmp5_get_regs(BMP5_REG_CHIP_ID, &reg_data, 1, dev);
 441:Core/Src/bmp5/bmp5.c ****         }
 442:Core/Src/bmp5/bmp5.c **** 
 443:Core/Src/bmp5/bmp5.c **** #if 0 // Suggestion by Bosch to fix init problem with checking INT_STATUS.por bit
 444:Core/Src/bmp5/bmp5.c ****         if (rslt == BMP5_OK)
 445:Core/Src/bmp5/bmp5.c ****         {
 446:Core/Src/bmp5/bmp5.c ****             rslt = bmp5_get_interrupt_status(&por_status, dev);
 447:Core/Src/bmp5/bmp5.c **** 
 448:Core/Src/bmp5/bmp5.c ****             if (rslt == BMP5_OK)
 449:Core/Src/bmp5/bmp5.c ****             {
 450:Core/Src/bmp5/bmp5.c ****                 if (por_status & BMP5_INT_ASSERTED_POR_SOFTRESET_COMPLETE)
 451:Core/Src/bmp5/bmp5.c ****                 {
 452:Core/Src/bmp5/bmp5.c ****                     rslt = BMP5_OK;
 453:Core/Src/bmp5/bmp5.c ****                 }
 454:Core/Src/bmp5/bmp5.c ****                 else
 455:Core/Src/bmp5/bmp5.c ****                 {
 456:Core/Src/bmp5/bmp5.c ****                     rslt = BMP5_E_POR_SOFTRESET;
 457:Core/Src/bmp5/bmp5.c ****                 }
 458:Core/Src/bmp5/bmp5.c ****             }
 459:Core/Src/bmp5/bmp5.c ****         }
 460:Core/Src/bmp5/bmp5.c **** #endif
 461:Core/Src/bmp5/bmp5.c ****     }
 462:Core/Src/bmp5/bmp5.c **** 
 463:Core/Src/bmp5/bmp5.c ****     (void)por_status; // Avoid compiler warning-as-error
 464:Core/Src/bmp5/bmp5.c **** 
 465:Core/Src/bmp5/bmp5.c ****     return rslt;
 466:Core/Src/bmp5/bmp5.c **** }
