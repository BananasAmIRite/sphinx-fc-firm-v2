 604:Core/Src/bmp5/bmp5.c ****         }
 605:Core/Src/bmp5/bmp5.c ****     }
 606:Core/Src/bmp5/bmp5.c **** 
 607:Core/Src/bmp5/bmp5.c ****     return rslt;
 608:Core/Src/bmp5/bmp5.c **** }
